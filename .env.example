# Required
ANTHROPIC_API_KEY=

# Optional — Claude model / tool-loop tuning
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
MAX_TOOL_ITERATIONS=8

# Optional — powers search_store_policies (RAG over policy pages). Without
# this, the tool reports itself unavailable instead of failing to start.
VOYAGE_API_KEY=

# Optional — the store and its UCP endpoints
SHOPIFY_STORE_DOMAIN=agentic-training.myshopify.com
UCP_ENDPOINT=
UCP_AGENT_PROFILE_URL=
UCP_TIMEOUT_MS=20000

# Optional — customer sign-in (Shopify new customer accounts). See
# src/shopify/customerAuth.js for where these come from.
CUSTOMER_ACCOUNT_CLIENT_ID=
CUSTOMER_ACCOUNT_CLIENT_SECRET=
CUSTOMER_ACCOUNT_ENDPOINT=
OIDC_DISCOVERY_URL=

# Must be the public URL this server is reachable at (not localhost) for
# customer sign-in and the UCP agent profile to work.
PUBLIC_BASE_URL=http://localhost:3000
WIDGET_ORIGIN=http://localhost:5173

PORT=3000
LOG_LEVEL=info
